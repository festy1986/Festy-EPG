name: TVGuide Debug (HBO-HIST)

on:
  workflow_dispatch:

jobs:
  debug-tvguide:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install deps (if needed)
        run: npm install

      - name: Run TVGuide channel test
        run: |
          mkdir -p debug
          cd debug

          cat > test.cjs <<'EOF'
          // paste the script I gave you here
          EOF

          node test.cjs

      - name: Upload debug results
        uses: actions/upload-artifact@v4
        with:
          name: tvguide-debug-output
          path: debug/tmp-tvguide-test
