name: One-Time Fix TVPassport Logos

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fix-tvpassport-logos:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Apply manual TVPassport logo mappings
        run: |
          node <<'EOF'
          const fs = require('fs')

          const guidePath = 'guides/TVPassport.xml'
          const base = 'https://raw.githubusercontent.com/festy1986/festy-epg/main/logos/'
          const enc = name => base + encodeURIComponent(name)

          const logos = {
            'ABC Portland': enc('WMTW-DT Poland Spring, Maine (ABC).png'),
            'CBS Portland': enc('WGME-DT Portland, Maine (CBS).png'),
            'FOX Portland': enc('WGME-DT2 Portland, Maine (FOX).png'),
            'NBC Portland': enc('WCSH-DT Portland, Maine (NBC).png'),
            'METV': enc('WMTW-DT2 Poland Spring, Maine (MeTV).png'),
            'LAFF': enc('WMTW-DT3 Poland Spring, Maine (Laff).png'),
            'COMET': enc('WPFO-DT3 Waterville, Maine. (Comet).png'),

            'Court TV': enc('Court TV.png'),
            'ION': enc('ION.png'),
            'ION PLUS': enc('ION Plus.png'),
            'Ion Plus': enc('ION Plus.png'),

            'Discovery Science': enc('Science HD.png'),
            'Nat Geo Wild': enc('National Geographic Wild.png'),
            'Smithsonian Channel': enc('smithsonian channel extra.png'),
            'LMN': enc('lifetime movie network.png'),
            'POP': enc('Pop Network HD.png'),
            'VICE HD': enc('vice1.png'),
            'VICE': enc('vice1.png'),
            'Crime & Investigation': enc('Crime & Investigation Network HD.png'),
            'FXM': enc('FX Movie HD.png'),
            'Hallmark Drama': enc('Hallmark Family.png'),
            'UP TV': enc('UPTV.png'),
            'NHL Network USA': enc('NHL Network HD.png'),
            'NBA TV USA HD': enc('NBA TV HD.png'),

            'Cinemax Classics': enc('Cinemax Classics.png'),
            'Cinemax Hits': enc('Cinemax Hits.png'),
            'HBO Drama) - Eastern HD': enc('HBO Drama.png'),
            'HBO Hits': enc('HBO Hits.png'),
            'HBO Movies': enc('HBO Movies.png'),
            'SHOXBET - Eastern': enc('showtime bet.png'),
            'Starz Encore Suspense': enc('STARZ Encore Suspense.png'),
            'Paramount+ with Showtime - Eastern Feed': enc('Paramount+ with Showtime.png'),
            'USA Network - East Feed': enc('usa network.png')
          }

          if (!fs.existsSync(guidePath)) {
            console.error(`Missing ${guidePath}`)
            process.exit(1)
          }

          let xml = fs.readFileSync(guidePath, 'utf8')
          let applied = 0

          xml = xml.replace(/<channel\b([^>]*)>([\s\S]*?)<\/channel>/g, (full, attrs, body) => {
            const m = body.match(/<display-name[^>]*>([\s\S]*?)<\/display-name>/i)
            if (!m) return full

            const name = m[1]
              .replace(/<[^>]+>/g, '')
              .replace(/&amp;/g, '&')
              .replace(/&apos;/g, "'")
              .trim()

            const logo = logos[name]
            if (!logo) return full

            const newBody = /<icon\b[^>]*\/>/i.test(body)
              ? body.replace(/<icon\b[^>]*\/>/i, `<icon src="${logo}"/>`)
              : body.replace(/(<display-name[^>]*>[\s\S]*?<\/display-name>)/i, `$1<icon src="${logo}"/>`)

            applied++
            console.log(`[logo] ${name} <= ${logo}`)
            return `<channel${attrs}>${newBody}</channel>`
          })

          fs.writeFileSync(guidePath, xml)
          console.log(`Applied ${applied} TVPassport logos`)
          EOF

      - name: Recompress TVPassport guide
        run: |
          gzip -c guides/TVPassport.xml > guides/TVPassport.xml.gz

      - name: Commit one-time TVPassport logo fix
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"

          git add guides/TVPassport.xml guides/TVPassport.xml.gz

          if git diff --cached --quiet; then
            echo "No TVPassport logo changes to commit"
            exit 0
          fi

          git commit -m "One-time fix TVPassport logos"
          git push
